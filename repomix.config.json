{
  "output": {
    "filePath": "repomix-output.md",
    "style": "markdown",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true
  },
  "include": ["src/**/*", "package.json", "tsconfig.json", "README.md"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".next/**",
      "node_modules/**",
      "scratch/**",
      "pnpm-lock.yaml",
      "*.pdf"
    ]
  }
}
